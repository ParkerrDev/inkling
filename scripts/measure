#!/bin/bash
# The numbers in the README: the delay inkling adds to a keystroke, what it
# adds to starting a shell, and what the proxy takes in memory. Release build,
# one measurement at a time, a few rounds so the spread shows.
#
#   scripts/measure [ROUNDS]
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

rounds=${1:-3}
cargo test --release --test pty --no-run --quiet
for round in $(seq "$rounds"); do
  echo "round $round"
  cargo test --release --test pty --quiet -- --ignored --test-threads=1 --nocapture measure 2>&1 |
    grep -E "median|added|resident|start to first"
done
