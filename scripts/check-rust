#!/bin/bash
# Every check a Rust change has to pass, in the order that fails fastest. The
# pre-push hook runs it, and CI runs the same file, so nothing passes in one
# place and fails in the other.
#
#   scripts/check-rust
#
# The lint tables in Cargo.toml and the limits in clippy.toml say what the
# rules are; `-D warnings` is what makes every one of them a failure.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

step() { printf '\033[1m==> %s\033[0m\n' "$*"; }

step "formatting"
cargo fmt --all --check

step "clippy, with every warning an error"
cargo clippy --all-targets --all-features -- -D warnings

step "tests"
cargo test --all-features

step "documentation, with a broken link an error"
RUSTDOCFLAGS="-D warnings" cargo doc --no-deps --all-features --quiet

# The dependency policy in deny.toml: licences, advisories, where crates come
# from. Skipped, and said so, where the tool is not installed; CI installs it.
if [ -f deny.toml ]; then
  if cargo deny --version >/dev/null 2>&1; then
    step "dependencies against deny.toml"
    cargo deny check
  else
    step "cargo-deny is not installed: dependencies not checked"
  fi
fi

step "all of it passed"
